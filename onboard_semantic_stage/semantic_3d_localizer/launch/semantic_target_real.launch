<launch>
  <arg name="execution_enabled" default="false"/>
  <arg name="publish_planner_goal" default="false"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/aligned_depth_to_color/camera_info"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <arg name="world_frame" default="map"/>
  <arg name="target_class" default="person"/>
  <arg name="weights" default="$(env HOME)/models/yolo_world/yolov8s-worldv2.pt"/>
  <arg name="confidence" default="0.25"/>
  <arg name="debug_bbox" default="[]"/>
  <node pkg="semantic_3d_localizer" type="semantic_target_node.py"
        name="semantic_target_node" output="screen">
    <rosparam command="load" file="$(find semantic_3d_localizer)/config/stereo_camera.yaml"/>
    <param name="execution_enabled" value="$(arg execution_enabled)"/>
    <param name="publish_planner_goal" value="$(arg publish_planner_goal)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="target_class" value="$(arg target_class)"/>
    <rosparam param="classes">[$(arg target_class)]</rosparam>
    <param name="weights" value="$(arg weights)"/>
    <param name="confidence" value="$(arg confidence)"/>
    <rosparam param="debug_bbox" subst_value="true">$(arg debug_bbox)</rosparam>
  </node>
</launch>
