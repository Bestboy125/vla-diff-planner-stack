<?xml version="1.0"?>
<package format="2">
  <name>semantic_raw_stereo_localizer</name>
  <version>0.1.0</version>
  <description>YOLO-World target localization from raw rectified D435 infrared stereo images.</description>
  <maintainer email="oem@example.com">oem</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <depend>atomic_skill_executor</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- depth_backend=lightglue additionally requires pip kornia and kornia_rs. -->
  <exec_depend>message_filters</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
</package>
