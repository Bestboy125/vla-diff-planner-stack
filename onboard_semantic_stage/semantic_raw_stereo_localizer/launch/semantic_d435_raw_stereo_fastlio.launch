<launch>
  <!-- Raw stereo only: color and RealSense depth generation are not required. -->
  <arg name="execution_enabled" default="false"/>
  <arg name="publish_planner_goal" default="false"/>
  <arg name="auto_publish_stable_goal" default="false"/>
  <arg name="planner_goal_topic" default="/goal"/>
  <arg name="odom_topic" default="/ekf/ekf_odom"/>
  <arg name="world_frame" default="world"/>
  <arg name="body_frame" default="base_link"/>
  <arg name="allow_empty_odom_child_frame" default="true"/>
  <arg name="altitude_reference_z_m" default="0.0"/>
  <arg name="min_operating_altitude" default="0.30"/>
  <arg name="max_operating_altitude" default="2.0"/>
  <arg name="max_approach_leg" default="2.0"/>
  <arg name="max_approach_stages" default="20"/>
  <arg name="approach_timeout" default="60.0"/>
  <arg name="target_class" default="person"/>
  <arg name="confidence" default="0.20"/>
  <arg name="depth_backend" default="sgbm"/>
  <arg name="detector_backend" default="local"/>
  <arg name="detector_service" default="/shared_yolo_world_detector/detect"/>
  <arg name="semantic_orbit_execution_enabled" default="false"/>
  <arg name="start_realsense" default="true"/>

  <group if="$(arg start_realsense)">
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
      <arg name="enable_color" value="false"/>
      <arg name="enable_depth" value="false"/>
      <arg name="enable_infra" value="true"/>
      <arg name="enable_infra1" value="true"/>
      <arg name="enable_infra2" value="true"/>
      <arg name="infra_width" value="640"/>
      <arg name="infra_height" value="480"/>
      <arg name="infra_fps" value="15"/>
      <arg name="enable_sync" value="true"/>
      <arg name="align_depth" value="false"/>
    </include>
  </group>

  <include file="$(find semantic_raw_stereo_localizer)/launch/semantic_raw_stereo_real.launch">
    <arg name="execution_enabled" value="$(arg execution_enabled)"/>
    <arg name="publish_planner_goal" value="$(arg publish_planner_goal)"/>
    <arg name="auto_publish_stable_goal" value="$(arg auto_publish_stable_goal)"/>
    <arg name="planner_goal_topic" value="$(arg planner_goal_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="allow_empty_odom_child_frame" value="$(arg allow_empty_odom_child_frame)"/>
    <arg name="target_class" value="$(arg target_class)"/>
    <arg name="confidence" value="$(arg confidence)"/>
    <arg name="depth_backend" value="$(arg depth_backend)"/>
    <arg name="detector_backend" value="$(arg detector_backend)"/>
    <arg name="detector_service" value="$(arg detector_service)"/>
  </include>

  <include file="$(find semantic_raw_stereo_localizer)/launch/semantic_orbit_executor.launch">
    <arg name="execution_enabled" value="$(arg semantic_orbit_execution_enabled)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="altitude_reference_z_m" value="$(arg altitude_reference_z_m)"/>
    <arg name="min_operating_altitude" value="$(arg min_operating_altitude)"/>
    <arg name="max_operating_altitude" value="$(arg max_operating_altitude)"/>
    <arg name="max_approach_leg" value="$(arg max_approach_leg)"/>
    <arg name="max_approach_stages" value="$(arg max_approach_stages)"/>
    <arg name="approach_timeout" value="$(arg approach_timeout)"/>
  </include>
</launch>
